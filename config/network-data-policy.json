{
  "schema_version": "workspace-network-data-policy/v1",
  "paths": {
    "incoming_cache_root": "/var/cache/workspace-datasets/incoming",
    "approved_root": "/var/lib/workspace-datasets/approved",
    "research_root": "/var/lib/workspace-datasets/research",
    "provenance_root": "/var/lib/workspace-datasets/provenance"
  },
  "cache": {
    "max_bytes": 85899345920,
    "max_job_bytes": 21474836480,
    "max_objects_per_job": 32,
    "allow_full_sync": false,
    "raw_retention": "ephemeral",
    "eviction_policy": "lru_unpinned"
  },
  "promotion": {
    "required_digest": "sha256",
    "enterprise_allowed_statuses": [
      "enterprise_approved"
    ],
    "research_allowed_statuses": [
      "enterprise_approved",
      "research_only"
    ],
    "deny_statuses": [
      "review_required",
      "blocked"
    ],
    "require_license_source": true,
    "require_provenance": true
  },
  "network": {
    "methods": [
      "GET",
      "HEAD"
    ],
    "https_only": true,
    "allow_redirects": true,
    "max_redirects": 3,
    "deny_private_special_destinations": true,
    "credentials_allowed": false,
    "caller_headers_allowed": false
  }
}
