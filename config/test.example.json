{
  "environment": "test",
  "test_mode_full_access": true,
  "database_path": "data/tasks.db",
  "artifact_root": "data",
  "profile_root": "profiles",
  "llm": {
    "provider": "ollama",
    "base_url": "http://127.0.0.1:11434",
    "model": "",
    "timeout_seconds": 1200,
    "keep_alive": "2m"
  },
  "model_policy": {
    "enabled": false,
    "fast_model": "",
    "research_model": "",
    "presentation_model": "",
    "report_model": "",
    "deep_model": "",
    "deep_escalation": true,
    "deep_prompt_chars": 14000
  },
  "internet_gateway": {
    "enabled": true,
    "allow_all_outbound_in_test": true,
    "audit_log": "data/activity/internet.jsonl",
    "user_agent": "3Agent-TestHarness/0.1"
  },
  "execution_gateway": {
    "enabled": true,
    "allow_all_commands_in_test": true,
    "audit_log": "data/activity/execution.jsonl"
  },
  "github": {
    "enabled": true,
    "repository": "caotiensinh/3agent",
    "branch": "main",
    "push_mode": "manual_or_gateway"
  }
}
