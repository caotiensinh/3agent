{
  "_profile_intent": "Confidential Core tuned for the exact 'dual RTX 5090 + 32GB system RAM' workstation class. Start from config/workspace.secure.json unchanged and adjust only resource_control, worker routing and model keep-alive so the one scarce resource on this class of host (system RAM, not GPU VRAM) gets a wider safety margin without touching security posture, model quality or context budget. See docs/WORKSPACE_LEAN_DUAL_5090_32GB_PROFILE.md for the reasoning and how to validate it with `workspace metrics` on the real machine.",
  "product_name": "WorkSpace",
  "environment": "secure-local-lean-32gb",
  "confidentiality_mode": "confidential",
  "test_mode_full_access": false,
  "database_path": "/var/lib/workspace/tasks.db",
  "artifact_root": "/var/lib/workspace/data",
  "profile_root": "profiles",
  "llm": {
    "provider": "ollama",
    "base_url": "http://127.0.0.1:11434",
    "model": "qwen3:30b",
    "timeout_seconds": 1200,
    "keep_alive": "20m"
  },
  "model_policy": {
    "enabled": true,
    "fast_model": "qwen3:14b",
    "research_model": "qwen3:30b",
    "presentation_model": "qwen3:14b",
    "report_model": "qwen3:14b",
    "deep_model": "qwen3:30b",
    "deep_escalation": true,
    "deep_prompt_chars": 14000,
    "worker_pool": {
      "enabled": true,
      "gpu0_url": "http://127.0.0.1:11435",
      "gpu1_url": "http://127.0.0.1:11436",
      "dual_url": "http://127.0.0.1:11434"
    },
    "resource_control": {
      "enabled": true,
      "max_vram_percent": 88,
      "max_ram_percent": 78,
      "max_gpu_util_percent": 95,
      "max_gpu_power_percent": 95,
      "max_gpu_temp_c": 83,
      "max_balance_skew_percent": 10,
      "queue_wait_seconds": 120,
      "queue_poll_seconds": 1,
      "model_size_safety_factor": 1.15,
      "model_ram_overhead_factor": 0.20,
      "serialize_generation": true,
      "reservation_ttl_seconds": 900
    }
  },
  "internet_gateway": {
    "enabled": true,
    "mode": "strict",
    "public_search_enabled": false,
    "allow_all_outbound_in_test": false,
    "allowed_search_hosts": [
      "html.duckduckgo.com",
      "lite.duckduckgo.com",
      "www.bing.com"
    ],
    "allowed_content_hosts": [],
    "max_response_bytes": 4194304,
    "max_query_chars": 240,
    "grant_ttl_seconds": 120,
    "audit_log": "/var/log/workspace/egress.jsonl",
    "broker_socket": "/run/workspace/egress.sock",
    "direct_egress": false,
    "broker_timeout_seconds": 60
  },
  "execution_gateway": {
    "enabled": true,
    "allow_all_commands_in_test": false,
    "audit_log": "/var/lib/workspace/data/activity/execution.jsonl"
  },
  "knowledge": {
    "public_mirror_enabled": true,
    "public_mirror_root": "/var/lib/workspace-knowledge-public",
    "trust_domain": "system:public",
    "network_direction": "inbound_only",
    "external_content_trust": "untrusted_external"
  },
  "github": {
    "enabled": false,
    "repository": "caotiensinh/3agent",
    "branch": "main",
    "push_mode": "operator_only"
  }
}
